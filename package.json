{
  "name": "ui-scaffold",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./styles.css": "./src/styles/global.css"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:lib && npm run registry:build && npm run registry:legal && npm run build:site",
    "build:site": "astro build",
    "build:lib": "tsup && tsc -p tsconfig.lib.json",
    "registry:tokens": "node scripts/sync-registry-tokens.mjs && biome format --write registry.json",
    "registry:build": "npm run registry:tokens && shadcn build --output public/r",
    "registry:legal": "cp LICENSE THIRD_PARTY_LICENSES public/r/",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "astro check",
    "check:all": "node scripts/check-all.mjs",
    "check:pre": "node scripts/check-all.mjs --pre"
  },
  "dependencies": {
    "@astrojs/react": "^5",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "astro": "^7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.28.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9",
    "@biomejs/biome": "^2.5.6",
    "tsup": "^8.5.1",
    "typescript": "~6"
  }
}
