---
import { categorizePreviewItems } from "@/catalog/component-categories.mjs";
import { previewItems } from "@/catalog/previews";
import DocsLayout from "@/layouts/docs.astro";
import { ComponentDocumentation } from "@/site/component-documentation";
import registry from "../../../registry.json";

// registry item の type を kind の正本にする。preview を足すだけで公開ページが
// 自動生成されるため、kind を渡さないと block も registry:ui 前提のテンプレートで描画され、
// ソースリンクが src/components/ui/<name>.tsx を指して 404 になる。
//
// node:fs でなく Vite の JSON import を使う。frontmatter は TS として型検査されるため
// node:fs は @types/node が無いと astro check が落ち、cwd 依存にもなる（実測: exit 1）。
const itemTypes = new Map<string, string>(
  registry.items.map((item: { name: string; type: string }) => [item.name, item.type]),
);

export function getStaticPaths() {
  return previewItems.map(({ name, title }) => ({
    params: { name },
    props: { name, title },
  }));
}

// biome-ignore lint/correctness/noUnusedVariables: Astro template から参照する値。
const { name, title } = Astro.props;
// biome-ignore lint/correctness/noUnusedVariables: Astro template から参照する値。
const kind = itemTypes.get(name) === "registry:block" ? "block" : "component";
// biome-ignore lint/correctness/noUnusedVariables: Astro template から参照する値。
const categories = categorizePreviewItems(previewItems).map((category) => ({
  name: category.name,
  items: category.items.map((item) => ({ name: item.name, title: item.title })),
}));
---

<DocsLayout title={`${title} - elchika-inc/ui`} description={`${title} の導入手順とプレビュー`}>
  <ComponentDocumentation
    categories={categories}
    name={name}
    title={title}
    kind={kind}
    client:load
  />
</DocsLayout>
