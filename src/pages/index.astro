---
import { previewItems } from "@/catalog/previews";
import Layout from "@/layouts/main.astro";
---

<Layout>
  <main class="min-h-svh bg-background px-6 py-12 text-foreground">
    <div class="mx-auto flex max-w-2xl flex-col gap-8">
      <header class="flex flex-col gap-3">
        <h1 class="text-3xl font-semibold tracking-tight">elchika-inc/ui</h1>
        <p class="text-muted-foreground">
          elchika-inc の共有 UI コンポーネントです。Base UI と Tailwind CSS v4 を使い、shadcn
          registry で配布します。
        </p>
      </header>

      <nav aria-labelledby="catalog-heading">
        <h2 id="catalog-heading" class="text-lg font-medium">横断カタログ</h2>
        <ul class="mt-3 flex flex-wrap gap-4">
          <li>
            <a
              class="text-primary underline underline-offset-4 focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring"
              href="/catalog/"
            >
              Light
            </a>
          </li>
          <li>
            <a
              class="text-primary underline underline-offset-4 focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring"
              href="/catalog-dark/"
            >
              Dark
            </a>
          </li>
        </ul>
      </nav>

      <nav aria-labelledby="preview-heading">
        <h2 id="preview-heading" class="text-lg font-medium">隔離プレビュー</h2>
        <ul class="mt-3 grid gap-3 sm:grid-cols-2">
          {
            previewItems.map(({ name, title }) => (
              <li class="rounded-lg border border-border p-4">
                <h3 class="font-medium">{title}</h3>
                <div class="mt-2 flex gap-3 text-sm">
                  <a
                    class="text-primary underline underline-offset-4 focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring"
                    href={`/preview/${name}/`}
                  >
                    Light
                  </a>
                  <a
                    class="text-primary underline underline-offset-4 focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring"
                    href={`/preview/${name}-dark/`}
                  >
                    Dark
                  </a>
                </div>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </main>
</Layout>
