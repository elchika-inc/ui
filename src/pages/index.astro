---
import { categorizePreviewItems } from "@/catalog/component-categories.mjs";
import { previewItems } from "@/catalog/previews";
import DocsLayout from "@/layouts/docs.astro";
import {
  directInstallCommand,
  MCP_INIT_COMMAND,
  NAMESPACE_REGISTRY_CONFIG,
  namespaceInstallCommand,
} from "@/site/installation.mjs";
import { ThemeToggle } from "@/site/theme-toggle";

// biome-ignore lint/correctness/noUnusedVariables: Astro template から参照する値。
const categories = categorizePreviewItems(previewItems);
---

<DocsLayout
  title="elchika-inc/ui - 共有UIコンポーネント"
  description="elchika-inc の共有 UI を shadcn registry から導入する手順"
>
  <main class="min-h-svh bg-background text-foreground">
    <header class="border-b border-border">
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-5 sm:px-8">
        <a
          href="/"
          class="font-heading font-semibold tracking-tight focus-visible:rounded-sm focus-visible:ring-3 focus-visible:ring-ring focus-visible:outline-none"
        >
          elchika-inc/ui
        </a>
        <nav class="ml-auto flex items-center gap-2" aria-label="主要ナビゲーション">
          <a
            href="#components"
            class="rounded-md px-3 py-2 text-sm text-muted-foreground hover:bg-state-hover hover:text-foreground focus-visible:ring-3 focus-visible:ring-ring focus-visible:outline-none"
          >
            Components
          </a>
          <a
            href="https://github.com/elchika-inc/ui"
            class="rounded-md px-3 py-2 text-sm text-muted-foreground hover:bg-state-hover hover:text-foreground focus-visible:ring-3 focus-visible:ring-ring focus-visible:outline-none"
          >
            GitHub
          </a>
          <ThemeToggle client:load />
        </nav>
      </div>
    </header>

    <section class="border-b border-border">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 lg:grid-cols-[1.15fr_0.85fr] lg:py-24">
        <div class="flex flex-col justify-center gap-6">
          <p class="font-mono text-xs font-medium tracking-[0.18em] text-primary uppercase">
            Shared interface registry
          </p>
          <h1 class="max-w-3xl font-heading text-4xl font-semibold tracking-tight sm:text-6xl">
            同じ操作感を、<br />プロダクトの数だけ。
          </h1>
          <p class="max-w-2xl text-lg leading-8 text-muted-foreground">
            Base UI と Tailwind CSS v4 で構築した、elchika-inc の共有 UI です。必要な component
            のソースを shadcn registry から取り込み、利用側で所有できます。
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="/components/button/"
              class="inline-flex h-9 items-center justify-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary-hover focus-visible:ring-3 focus-visible:ring-ring focus-visible:outline-none"
            >
              Components を見る
            </a>
            <a
              href="#installation"
              class="inline-flex h-9 items-center justify-center rounded-lg border border-border px-4 text-sm font-medium hover:bg-state-hover focus-visible:ring-3 focus-visible:ring-ring focus-visible:outline-none"
            >
              導入手順へ
            </a>
          </div>
        </div>
        <div class="rounded-2xl border border-border bg-card p-5 shadow-sm sm:p-7">
          <div class="mb-5 flex items-center justify-between border-b border-border pb-4">
            <span class="font-mono text-xs text-muted-foreground">registry / quick start</span>
            <span class="rounded-full bg-accent px-2.5 py-1 text-xs font-medium text-accent-foreground">
              source-owned
            </span>
          </div>
          <pre class="overflow-x-auto text-sm leading-7"><code>{directInstallCommand("button")}</code></pre>
        </div>
      </div>
    </section>

    <section id="installation" class="mx-auto max-w-6xl scroll-mt-8 px-5 py-16 sm:px-8 lg:py-24">
      <div class="mb-10 max-w-2xl">
        <p class="font-mono text-xs font-medium tracking-wider text-primary uppercase">Installation</p>
        <h2 class="mt-3 font-heading text-3xl font-semibold tracking-tight sm:text-4xl">
          3つの導入経路
        </h2>
        <p class="mt-4 leading-7 text-muted-foreground">
          1 component の試用から、名前空間や Claude 経由の探索まで段階的に選べます。
        </p>
      </div>

      <ol class="grid gap-5 lg:grid-cols-3">
        <li class="flex flex-col gap-5 rounded-xl border border-border p-6">
          <span class="font-mono text-sm text-primary">01 / Direct URL</span>
          <div>
            <h3 class="font-heading text-xl font-semibold">直接 URL</h3>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">設定なしで component を1件取得します。</p>
          </div>
          <pre class="mt-auto overflow-x-auto rounded-lg bg-muted p-4 text-sm"><code>{directInstallCommand("button")}</code></pre>
        </li>
        <li class="flex flex-col gap-5 rounded-xl border border-border p-6">
          <span class="font-mono text-sm text-primary">02 / Namespace</span>
          <div>
            <h3 class="font-heading text-xl font-semibold">@elchika</h3>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">
              components.json に registry を登録し、短い名前で取得します。
            </p>
          </div>
          <pre class="overflow-x-auto rounded-lg bg-muted p-4 text-sm"><code>{NAMESPACE_REGISTRY_CONFIG}</code></pre>
          <pre class="overflow-x-auto rounded-lg bg-muted p-4 text-sm"><code>{namespaceInstallCommand("button")}</code></pre>
        </li>
        <li class="flex flex-col gap-5 rounded-xl border border-border p-6">
          <span class="font-mono text-sm text-primary">03 / MCP</span>
          <div>
            <h3 class="font-heading text-xl font-semibold">shadcn MCP</h3>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">
              shadcn CLI 同梱 MCP を初期化し、生成された .mcp.json を有効にするため Claude を再起動します。
            </p>
          </div>
          <pre class="mt-auto overflow-x-auto rounded-lg bg-muted p-4 text-sm"><code>{MCP_INIT_COMMAND}</code></pre>
        </li>
      </ol>

      <aside class="mt-8 rounded-xl border border-warning bg-warning p-6 text-warning-foreground">
        <h3 class="font-heading text-lg font-semibold">トークン設置時の注意</h3>
        <p class="mt-2 max-w-4xl text-sm leading-6">
          shadcn init が生成した :root / .dark の色 alias を削除し、elchika-ui/tokens.css の import
          に一本化してください。component を add するたびに alias block が再追記されるため、その都度再削除が必要です。
        </p>
        <pre class="mt-4 overflow-x-auto rounded-lg bg-background p-4 text-sm text-foreground"><code>@import "./elchika-ui/tokens.css";</code></pre>
      </aside>
    </section>

    <section id="components" class="border-t border-border bg-muted/40">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 lg:py-24">
        <div class="mb-10 max-w-2xl">
          <p class="font-mono text-xs font-medium tracking-wider text-primary uppercase">Components</p>
          <h2 class="mt-3 font-heading text-3xl font-semibold tracking-tight sm:text-4xl">
            カテゴリから探す
          </h2>
        </div>
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
          {
            categories.map((category) => (
              <section class="rounded-xl border border-border bg-card p-5">
                <h3 class="font-heading font-semibold">{category.name}</h3>
                <ul class="mt-4 flex flex-col gap-1">
                  {category.items.map(({ name, title }) => (
                    <li>
                      <a
                        href={`/components/${name}/`}
                        class="block rounded-md px-2 py-1.5 text-sm text-muted-foreground hover:bg-state-hover hover:text-foreground focus-visible:ring-3 focus-visible:ring-ring focus-visible:outline-none"
                      >
                        {title}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      </div>
    </section>

    <footer class="border-t border-border">
      <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-8 text-sm text-muted-foreground sm:px-8">
        <p>elchika-inc/ui — ソースを共有し、利用側で所有する UI registry</p>
        <p>MIT License</p>
      </div>
    </footer>
  </main>
</DocsLayout>
